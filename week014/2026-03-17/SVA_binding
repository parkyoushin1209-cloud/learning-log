endmodule : counter_rtl // DUT system verilog

//DUT VHDL design
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all;
entity counter is
   generic (SIZE : natural := 3);
   port(
    count_out : out std_logic_vendor(SIZE -1 downto 0); //counter output
    data_in : in std_logic_vendor(SIZE -1 downto 0); // data to load
    ld_enb : in std_logic; // parallel load enable, active high
    rst_n : in std_logic; // reset, active high
    clk : in std_logic; // system clock
   )
end entity counterl;   // DUT VHDL

architecture rtl of counter is
   signal count : unsigned(SIZE - 1 downto 0); // 내부 신호
   signal tc    : std_logic;
begin // architecture rtl
  .. // DUT design
end architecture rtl;

//Property module. Could also be a checker instead of a module
module counter_props(
   input logic[2:0] count_out,
   input logic ld_enb, rst_n,
   input logic[2:0] count,
   input logic tc,
   input logic clk
);

timeunit 1ns; timeprecision 100ps;
property p_tc;
disable iff(!rst_n)
(count) == 3'b111 |-> tc;
endproperty : p_tc
ap_tc : assert property(@(posedge clk) p_tc) else 
   $error("%0t error in terminal count", $time);
ap_counter : assert property(@(posedge clk) tc |-> ##8 tc);
endmodule : counter_props // verification system verilog module or checker

