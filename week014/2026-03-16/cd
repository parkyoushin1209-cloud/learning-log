module static_auto;
bit[8:0] data = 9'b00000101;
bit clk;
initial forever #10 clk = !clk;
always_ff @(posedge clk) begin
   $display("@ %t  data=%b", $time, data);
   for(int i=0; i<3; i++) begin
      automatic int auto_lp = 0;
      for(int j=0; j<3; j++) begin
         $display("auto_lp %d data[auto_lp]= %b",
                                  auto_lp, data[auto_lp]);
         ap_data012 : assert property(data[auto_lp]==1'b1);
         auto_lp++;
      end
   end

   for(int i=0; i<3; i++) begin
      static int static_lp = 0;
      for(int j=0; j<3; j++) begin
         $display("$sampled(static_lp) %d data[$sampled(static_lp)] =%b",
                    $sampled(static_lp), data[$sampled(static_lp)]);
         ap_data08 : assert property(data[static_lp]==1'b1);
         static_lp++;
      end
   end
end 
endmodule : static_auto
