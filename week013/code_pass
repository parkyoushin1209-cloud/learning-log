module my_control();
initial begin
    $display("%0t %m Disabling assetion during init....", $time);
    $assertoff(0, top_tb.cpu_rtl_1);
    @(top_tb.reset_n === 1'b1);
$display("%0t %m Enabling assertions after init...", $time);
$asserton(0, top_tb.cpu_rtl_1);
end
endmodule : my_control
module top_tb;
logic clk = 1'b0,   reset_n = 1'b0;
bus_if b_if;
cpu_rtl cpu_rtl_1(clk, reset_n, *);
my_control my_control();
..
endmodule : top_tb
