endproperty : pX7
// a가 증가했으면 다음 사이클에 b가 0, 1, 2, 3, 4 중 하나의 수만큼 반복해야 하고 b가 나온 다음 사이클에 c가
// 1이어야 하며 다음 사이클부터 c가 10 사이클동안 0이어야 하며 다음 사이클 에서 d가 1이어야 함

========================================================== 7
property pX8;
$rose(a) |=> ##[0:$] ##1 b ##[0:$] d;
endproperty : pX8
/*실패할 수 없는 이유
1. new a가 없다 -> 공허한 성공 != 실패
2. a가 나왔다 -> ##[0:$] 는 기능적으로만 봤을 때 ##[0:$] 1'b1로 볼 수 있으며 b가 안나오면 
계속 1 1 1 1 ... 반복 이러다 클럭 틱이 부족하면 weak이므로 공허한 성공 // |=> 의 consequent는 기본적으로 weak
아니면 b가 나오면 다음으로 넘어가고 이는 b는 최소 1번은 참임을 보장하는 것이고 b는 한 번만 나와도 바로 다음으로 넘어감
3. a가 나오고 b까지 나왔다 -> 다음 사이클에서 d는 나오거나 안 나오거나 두 가지 모두 가능 
=> 따라서 이 프로퍼티는 실패할 수 없음
*/

========================================================== 8

$rose(a) |=> b[*3] ##1 c; 
// new a 발생시 다음 사이클에 b가 3사이클 연속으로 1이어야 하고 이 다음 사이클에서 c가 1이어야 함
$rose(a) |=> b[->3] ##1 c; 
// new a 발생시 다음 사이클부터 시작해서 b가 연속으로 1은 아니어도 되나 1이 3번 나온 다음 사이클에서는 c가 1이어야 함
$rose(a) |=> b[=3] ##1 c;
// new a 발생시 다음 사이클부터 시작해서 b가 연속으로 1은 아니어도 되며 1이 3번 나온 다음 사이클에서도 c가 바로 오지 않아도 되나
// b가 한 번 더 나오는 것은 안됨 c는 b가 3번 1이 나온 상태라면 언제든 1이 되면 됨
$rose(a) |=> [*3] ##1 b ##1 c;
// new a 발생시 5사이클 뒤 b가 1 다음 사이클에 c가 1이어야 함 
// 즉 $rose(a) |=> ##4 b ##1 c로 볼 수 있음

