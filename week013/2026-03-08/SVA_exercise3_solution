다음 프로퍼티의 의미 설명

a. sequence qAck; @(posedge clk) ##3 ack; endproperty : qACK // 3사이클 후 ack가 1이어야 함

   property pReqAck; $rose(req) |-> qAck; endproperty : pReqAck // new req 발생시 발생한 사이클에 qAck도 1이어야 함

   property pAckThenPrevReq; qAck.triggered |-> $past(req, 3); // qAck가 참이되는 시점 클럭에서 3사이클 전 req가 1이어야 함
   endproperty : pAckThenPrevReq                               // triggered는 qAck가 거짓이면 0을 반환함


b. property pReq3Acks; $rose(req) |=> ack[*3]; endproperty : pReq3Acks 
//새 req가 발생하는 클럭틱 포함 다음 2사이클에서도 ack가 1이면 됨


c. property pReqAckOnce; $rose(req) |=> ack[->1] within `true[*3];
   endproperty : pReqAckOnce
   // 새 req가 발생한 후 다음 사이클에서 3사이클 이내에 ack가 1번 나와야 함

d. property pReqAckDone; $rose(req) ##1 ack[->2] ##1 data_xfr |=> done;
   endproperty : pReqAckDone
// 새 req가 발생한 후 다음 사이클부터 ack가 불연속적이든 연속적이든 두 번 나올 때까지 대기하다 두 번 나오는 순간 한 사이클 뒤
// data_efr이 1 다음 사이클에 done이 1이어야 함

e. property pReqAckDataXFrs; $rose(req) |=> (ack && data_xfr)[=1:31] within `true[*40]
endproperty : pReqAckDataXFrs
// 새 req가 나오고 한 사이클 뒤 (ack && data_xfr)이 1이 1번에서 31번 사이로 나와야 하며 이는 총 40사이클 이내에 만족되야 함 

f. property pReqAck100DataXfr; $rose(req) |=> data_xfr[*16] within ack[=1 : 100];
endproperty : pReqAck1000DataXFrs
// 새 req가 나온뒤 다음 사이클부터 data_wfr이 연속으로 16번 나와야 하며 이는 ack가 1~100번 나오는 사이에 발생해야 함
