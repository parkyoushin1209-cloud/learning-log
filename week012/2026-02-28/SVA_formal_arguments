동시 어써션에서 사용하는 표현식은 정수 타입과 호환되는 결과를 내놓아야 함
(부분 표현은 전체 표현이 이 규칙을 만족하는 한 이 규칙을 지킬 필요는 없음)

다음 타입들은 형식인자로 사용되거나 동시 어써션에 적용 가능(단, 결과 expr의 평가 결과는 불린 값을 반환해야 함)
enum, byte, shortint, int, longint, integer, time, bit, logic, reg, shortreal, real, realtime, signed, unsigned

typedef enum {BK_RED, BK_GREEN, BK_BLUE} color_e;
color_e color;
bit clk, a, b, r, d;
real r = 2.1, y = 10.0;
realtime rtime;
time t;
logic[31:0] rdata;
assert property(r == y);
assert property(($realtime - rtime) > 10.2);
assert property(($time - t) > 10ns);
assert property(rdata == 32'hFFFF0000);
assert property(color == BK_BLUE);

어써션 평가에서 샘플링 되는 다이나믹 배열, 큐, 연관배열의 요소들은 평가되기 전에 배열에서 제외되거나 resize될 수 있으나
어써션 평가가 완료될 때까지 어써션의 범위 내에서 계속 존재해야 함

절차적 동시 어써션 내의 표현식은 원칙적으로 자동 변수를 참조할 수 없음
자동 변수, 지역 변수, active free checker 변수의 샘플된 값은 그들의 현재 값임( preponed 리전이 아닌 active리전에서 평가됨)


module autom;
bit clk, a, b, rd; // 정적 변수 선언
//automatic bit k, z; // 불법적 선언
logic[31:0] wdata, foo = 32'hFFFFFFFA. bar = 32'hFFFFFFFB;
int m, n, w;
initial forever #10 clk = !clk;
default clocking cb_clk @(posedge clk);endclocking

always @(posedge clk) begin : alw_foo
automatic logic k=1'b0; // active 리전에서 평가
static logic m = 1'b1; // preponed 리전에서 평가
// k <= !k; 논블로킹 할당은 자동 변수에 올 수 없음
k = !k; // 어써션이 아니므로 문제 없이 동작
for(int i=0; i< 10 ; i++) // 루프에 선언된 변수 i는 자동 변수
a4: assert property(foo[i] && bar[i]);
/*  규칙상 동시 어써션이 자동 변수를 참조할 수 없음
어써션 평가 시점에 i는 이미 10일 수 있음
automatic 대신 generate를 사용하면 컴파일 타임에 어써션을 개별적으로 생성하고 preponed 리전에서 안정적 샘플이 가능함*/
ap_k : assert property(k);
/*  assert 뒤에 property가 붙으면 동시 어써션으로 봄
어써션은 observed 리전에서 평가되는 자동변수는 active리전에서 생성되고 값이 바뀜
=> 어써션이 k를 보려할 때 이미 사라지거나 원치 않는 시퀀스 값일 수 있음*/
end
endmodule
