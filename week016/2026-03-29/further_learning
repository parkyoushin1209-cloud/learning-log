property i2c_switch_mode_p;
      @(posedge clk_asrt) disable iff(sva_rst_n === 1'b0)
      (i2c_mode === INPUT_MODE) ##1 (i2c_mode === OUTPUT_MODE)
      |->
      (i2c_scl === 1'b0)
