3. 드라이버 확장
virtual task send(BaseTr tr);
  @(posedge vifc.clk);

  vifc.a     <= tr.a;
  vifc.valid <= tr.valid;
  vifc.data  <= tr.data;
  vifc.addr  <= tr.addr;

  // handshake 예시
  if (tr.valid) begin
    wait (vifc.ready);
  end
endtask

