interface fsm_ifc(input logic clk);  
  logic a;
  logic valid;
  logic ready;

  // Driver용
  clocking drv_cb @(posedge clk);  //같은 클럭 사용 다만, 이후에 클럭 사용할 때 반드시 클럭킹 블럭의 클럭 사용 
    output a, valid;
    input  ready;
  endclocking

  // Monitor용 //모니터에서 next_state를 직접적으로 넣어서 관찰하는 것보다 출력 신호를 파악해 상태 파악할 것을 권
  clocking mon_cb @(posedge clk);
    input a, valid, ready;
  endclocking

endinterface
