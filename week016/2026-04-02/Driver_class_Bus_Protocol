==================에러 주입 방식========================
1. 단일 에러 클래스로만 해결하려고 하지 말기 -> 케이스가 많아지면 클래스 수 폭발적
2. 트랜 잭션 내부에 에러 타입 넣기
typedef enum {
  NO_ERR,
  INVALID_VALUE,
  TIMING_VIOLATION,
  PROTOCOL_VIOLATION
} err_t;

class BaseTr;
  rand bit a;
  rand err_t err_type;
endclass
3. 드라이버에서 에러 구체화하기
case (tr.err_type)
  NO_ERR: begin
    vifc.a <= tr.a;
  end

  INVALID_VALUE: begin
    vifc.a <= 'x;
  end

  TIMING_VIOLATION: begin
    @(negedge vifc.clk);
    vifc.a <= tr.a;
  end

  PROTOCOL_VIOLATION: begin
    vifc.valid <= 1;
    // ready 무시
  end
endcase ////에러는 “신호 레벨”에서 터져야 의미 있음

4. function void pre_tx(BaseTr tr);
  if (tr.err_type == INVALID_VALUE)
    tr.a = ~tr.a;
endfunction
콜백은 에러 동작 수정시에만 메인은 드라이버에

