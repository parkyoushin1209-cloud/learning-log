checker cntr_chk(
    input logic[3:0] data_in,
    input logic ld,
    input logic[3:0] counter,
    input logic clk, rst_n,
    output logic[3:0] vout);
    import counter_pkg::*;
    int cover_count, fail_count, vtest;
    default disable iff !rst_n;
    default clocking cb_clk @(posedge clk); endclocking
    ap1 : assert #0 (data_in != 0);
    ap2 : assert final (counter != 0);
    always_ff @(posedge clk) begin
        ap_data_in_size: assert property(ld |-> counter == data_in);
    end
    assign vout=data_in; // output으로 할당
    assign vtest= vout; // 지역 변수로 할당.
    property p_load;
    logic[3:0] v_data_in;
    (ld, v_data_in=data_in) |=> counter==v_data_in;
    endproperty : p_load
    ap_load : assert property (p_load); //동시 어써션
    ap_count : assert property(
        disable iff(!rst_n || ld)
        (counter != MAX_COUNT) |=> counter==$past(counter)+1'b1);

    ap_hold : assert property(
        disable iff(!rst_n || ld)
        counter==MAX_COUNT |=> counter==$past(counter));

    ap_min_load : assume property(
        ld |-> not(data_in <MIN_COUNT));

    ap_max_load : assume property(
        ld |-> not(data_in> MAX_COUNT))
    cover_count++; else fail_counter++ ;

    ap_stable8 : assume property(disable iff(!rst_n ||ld)
        $stable(counter) |-> ##[1:8] !$stable(counter));

    ap_reset_ok2 : assert property(
        disable iff(0)
        !rst_n |=> counter==MIN_COUNT);
endchecker

module counter_max #(MAX_COUNT=9, MIN_COUNT=2)( //파라미터 포트 리스트
