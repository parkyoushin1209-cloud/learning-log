시스템 베릴로그는 기능적 커버리지를 얻기 위해 두 개의 생성자 집합을 제공한다:
Cover property / cover sequence / covergroup.
시스템 베릴로그는 체커에서 어써션 뿐만 아니라 1개 이상의 커버그룹 선언과 인스턴스화도 허용한다. 이들은 체커 내부 절차적 스코프 외부에서만 허용된다.

import uvm_pkg::*;
`include "uvm_macros.svh"
typedef enum {NOP, ADD, SUB, MULT, JMP, MOV, READ, WRITE, IDLE} instr_e;
typedef enum {FETCH, DECODE, EXECUTE} mode_e;
typedef enum {PC, IR1, IR2, REGA, REGB, MAR, REG_FILE, STK} resource_e;
checker cpu_chk(input bit clk,
                instr_e instr,
                bit[15:0] addr, data,
                mode_e mode,
                resource_e resource);
covergroup instr_cg;
      Instr_cp : coverpoint instr;
      Resource_cp : coverpoint resource;
      Mode_cp : coverpoint mode;
endgroup : instr_cg
instr_cg inst_cg1=new();

covergroup addr_cg @(posedge clk);
      addr_cp : coverpoint addr
              { bins instrunction = {[0:255]};
                bins data    = {[256:32767]};
      }
endgroup : addr_cg
addr_cg addr_cg1=new();

always_ff @(posedge clk)
   if(mode==FETCH) instr_cg1.sample();

final begin : report_cov
   $display("Final cov achieved %g ", $get_coverage());
end : report_cov

endchecker : cpu_chk

module cpu_module;
timeunit 1ns; timeprecision 1ns;

   bit clk=1;
   instr_e instr;
   bit[15:0] addr=5, data = 1000;
   mode_e mode=EXECUTE;
   resource_e resource;
   initial forever #50 clk=!clk;
   cpu_chk cpu_1(.*);

   default clocking @(posedge clk); endclocking

   initial begin
    repeat(10) begin : stim_gen
    #1; @(posedge clk);
    if(!randomize(addr, data, instr, mode, resource))
       `uvm_error("MYERR", "This is a randomize error");
    $displat("addr %0x instr %p mode %p resource %p",
              addr, instr, mode, resource);
    end : stim_gen
    #100 $finish;
   end : stimulus
endmodule : cpu_module
