규칙: 선언에서 형식 인자의 기본값으로 하는 컨텍스트 값 함수
체커의 중요한 이점은 체커가 인스턴스화되는 문맥에서의 유연성임
체커로 인스턴시에이션 문맥을 전달하기 위해 이 것을 문맥 값 함수($inferred_clock, $inferred_disable)와 결합하는 것은 재사용성 높은 코드 생성에 도움이 되고 따라서 코드의 장황성을 상당히 줄여준다.
문맥 값 함수는 체커 선언 내 형식 인자의 기본값으로서만 사용될 수 있다; 이들은 체커의 몸체에 존재할 수 없다. 
이런 함수들은 체커 동작을 인스턴시에이션 문맥에 적응할 수 있도록 할 수 있다.

import uvm_pkg::*;
`include "uvm_macros.svh"
parameter WIDTH =2; //파라미터를 체커 외부에 둠, 내부에 두는 것은 불법임
checker chk_decrement (bit [WIDTH-1 : 0] test_expr,
                       event clk = $inferred_clock, // 기본 인자
                       bit rst = $inferred_disable);
a1 : assert property( @ clk
                 disable iff (rst) !$stable(test_expr) |->
                 ($past(test_expr) == test_expr + 1'b1));
endchecker : chk_decrement

module m();
bit clk, clk2, dec_enabled, reset;
bit [WIDTH - 1:0] d;
default clocking default_clk @(posedge clk) ; endclocking
default disable iff reset;
initial forever #5 clk = !clk;
initial forever #7 clk2 = !clk2;
chk_decrement d_chk_static(d);
// 다음과 동일함
// chk_decrement d_chk_verbose(d, posedge clk, reset);
// Clock은 문맥으로부터 추론됨

always @(posedge clk2)
if(dec_enabled)
chk_decrement d_chk_proc (d);
// 다음과 동일
// chk_decrement d_chk_verbose (d, posedge clk2, reset);
// Clock이 always 감지리스트로부터 추론됨

always @(posedge clk)
if(!randomize(d, dec_enabled))
`uvm_error("MYERR", "This is a randomize error");

endmodule : m
