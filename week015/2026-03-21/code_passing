다음의 예시는 체커를 DUT로 바인딩하는 개념을 설명한다.
module dut(input bit clk, a, b);
bit x, y;
always @(posedge clk) begin
    x <= !a;
    y <= b;
end
endmodule : dut 

checker unit_chk(event clk_ev, input bit x, y, a, b); // 독립적으로 컴파일
always_ff @clk_ev begin
    ap_xyab: assert property($rose(x) |-> y ##1 a &&& b);
    $display("x=%b, y=%b, a=%b, b=%b", x, y, a, b);
end
endchecker : unit_clk

module top;
bit clk_top, a, b, c1, d1;
initial forever #10 clk_top = !clk_top;
int r1;
dut dut1( .clk(clk_top), .a(a), .b(b));

// 체커 바인딩
bind dut1 unit_chk my_checker1(posedge clk, x, y, a, b); // DUT신호로 연결
//모든 체커의 실인자들이 dut신호들로 묶임(즉, 인자들과 내부 신호들이 이름으로 연결됨)
endmodule : top
